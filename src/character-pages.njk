---
layout: layouts/base.njk
pagination:
  data: encyclopedia.entries
  size: 1
  alias: ch
  addAllPagesToCollections: true
permalink: "/characters/{{ ch.id }}/"
eleventyComputed:
  title: "{{ ch.name }}とは|コミックと実写の違い・演者別解説"
  description: "{{ ch.name }}({{ ch.en }})を解説。{{ ch.comic | truncate(80, true, '…') }}"
---
<section data-page="chara-detail">
  <div class="wrap">
    <p class="crumb"><a href="{{ '/' | url }}">ホーム</a> › <a href="{{ '/characters/' | url }}">キャラ検索</a> › {{ ch.name }}</p>

    <div class="sec-head">
      <span class="en">{{ ch.en }}</span>
      <h2 class="chara-name-h">{{ ch.name }}</h2>
    </div>

    <div class="enc-facts">
      <div><b>本名</b>{{ ch.real_name }}</div>
      <div><b>初登場</b>{{ ch.first_appearance }}</div>
      <div><b>原作者</b>{{ ch.creators }}</div>
      <div><b>能力</b>{{ ch.power }}</div>
    </div>

    <div class="enc-body article-body">
      <h3>📖 コミックでは</h3>
      <p>{{ ch.comic }}</p>

      <h3>🎬 実写では</h3>
      {%- for v in ch.live_versions %}
      {%- if '未登場' in v.ver %}
      <div class="enc-ver enc-ver-none">
        <p class="enc-ver-head"><b>{{ v.ver }}</b>{% if v.years %} <span>{{ v.years }}</span>{% endif %}</p>
        <p>{{ v.text }}</p>
      </div>
      {%- else %}
      <div class="enc-ver">
        <p class="enc-ver-head"><b>{{ v.ver }}</b>{% if v.actor %} <span>演: {{ v.actor }}</span>{% endif %}{% if v.years %} <span>{{ v.years }}</span>{% endif %}</p>
        <p>{{ v.text }}</p>
      </div>
      {%- endif %}
      {%- endfor %}

      {%- if ch.anime %}
      <h3>アニメでは</h3>
      <p>{{ ch.anime }}</p>
      {%- endif %}

      {%- if ch.appearances %}
      <h3>登場作品と活躍</h3>
      {%- if ch.appearances.live and ch.appearances.live.length %}
      <h4 class="app-sub">🎬 実写(公開順)</h4>
      <div class="app-list">
        {%- for x in ch.appearances.live | sortAppLive(mcu.works) %}
        <div class="app-item">
          <p class="app-head"><b>{{ (x.work_id | workTitle(mcu.works)) if x.work_id else x.title }}</b><span class="app-role">{{ x.role }}</span></p>
          {%- if x.sp %}
          <details class="spoiler-box"><summary>⚠ ネタバレあり解説を表示</summary><p>{{ x.sp }}</p></details>
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if ch.appearances.comic and ch.appearances.comic.length %}
      <h4 class="app-sub">📖 コミック</h4>
      <div class="app-list">
        {%- for x in ch.appearances.comic %}
        {%- set book = (x.db_no | comicByNo(comics.items)) if x.db_no else null %}
        <div class="app-item">
          <p class="app-head">
            {%- if book -%}
            {%- set csLabel = { A: '在庫あり', S: '店頭在庫のみ', R: '流通限定', D: '9/30消滅' } -%}
            <span class="cs-badge {{ book.status_code }}">{{ csLabel[book.status_code] }}</span>
            {%- else -%}
            <span class="cs-badge none">{{ x.jp or '未邦訳' }}</span>
            {%- endif -%}
            <b>{{ book.title if book else x.title }}</b><span class="app-role">{{ x.role }}</span></p>
          {%- if x.sp %}
          <details class="spoiler-box"><summary>⚠ ネタバレあり解説を表示</summary><p>{{ x.sp }}</p></details>
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- endif %}

      {%- if ch.note %}
      <p class="term-note">{{ ch.note }}</p>
      {%- endif %}

      {%- set goods = charaGoods.chars[ch.id] %}
      {%- if site.affiliateEnabled and goods %}
      <h3>🧸 グッズを探す</h3>
      {%- if goods.asins and goods.asins.length %}
      <div class="app-list">
        {%- for a in goods.asins %}
        <div class="app-item"><p class="app-head"><a class="amz-btn" href="https://www.amazon.co.jp/dp/{{ a }}?tag={{ site.amazonTag }}" rel="sponsored noopener" target="_blank">Amazonで見る</a><span class="pr-label">[PR]</span></p></div>
        {%- endfor %}
      </div>
      {%- endif %}
      <p class="w-buy">
        <a class="amz-btn" href="https://www.amazon.co.jp/s?k={{ (goods.query + ' フィギュア') | urlencode }}&tag={{ site.amazonTag }}" rel="sponsored noopener" target="_blank">フィギュア</a>
        <a class="amz-btn" href="https://www.amazon.co.jp/s?k={{ (goods.query + ' Tシャツ') | urlencode }}&tag={{ site.amazonTag }}" rel="sponsored noopener" target="_blank">Tシャツ・アパレル</a>
        <a class="amz-btn" href="https://www.amazon.co.jp/s?k={{ (goods.query + ' グッズ') | urlencode }}&tag={{ site.amazonTag }}" rel="sponsored noopener" target="_blank">グッズ全般</a>
        <span class="pr-label">[PR]</span></p>
      <p class="term-note">Amazonの検索結果を開きます。公式・非公式が混在するため、販売元をご確認のうえお買い求めください。</p>
      {%- endif %}
    </div>

    <p class="enc-back"><a href="{{ '/characters/' | url }}">← キャラ検索に戻る</a></p>
  </div>
</section>
