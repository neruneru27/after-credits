{#- 実写作品1件のカード。assets/js/live.js の makeItem と同一マークアップを維持すること -#}
{#- amz: amazonLinks.json の該当エントリ({bd,dvd,pv} or undefined)、meter: prepMeterフィルタの結果 -#}
{%- macro workItem(w, num, amz, tag, enabled, meter) -%}
{%- set head -%}
<span class="w-num">{{ num }}</span><div><h3>{{ w.title }}{% if w.brand %}<span class="w-badge">単独OK</span>{% endif %}{% if w.status == 'upcoming' %}<span class="w-badge upcoming">公開予定</span>{% endif %}</h3>{% if w.desc %}<p class="w-desc">{{ w.desc }}</p>{% endif %}<p class="w-meta">日本: {{ w.date_jp | fmtDate }}{% if w.chrono_note %} / {{ w.chrono_note }}{% endif %}{% if meter %} <span class="prep-meter {{ meter.cls }}">{{ meter.label }}</span>{% endif %}</p></div><span class="watch-check" data-id="{{ w.id }}" role="checkbox" aria-checked="false" tabindex="0" title="視聴済みにする">✓</span><span class="w-type {{ w.type }}">{{ {'movie':'映画','drama':'ドラマ','anime':'アニメ','special':'SP'}[w.type] }}</span>
{%- endset -%}
{%- set moreLink -%}<p class="w-more"><a href="{{ ('/live/' + w.id + '/') | url }}">→ 作品ページ(クレジットシーン・登場キャラ)</a></p>{%- endset -%}
{%- if not w.syn -%}
<div class="watch">{{ head | safe }}</div>
<div class="w-more-solo">{{ moreLink | safe }}</div>
{%- else -%}
<details class="watch-d"><summary class="watch has-detail">{{ head | safe }}</summary><div class="w-detail"><p class="w-syn"><b>あらすじ(ネタバレなし):</b> {{ w.syn }}</p>
{%- if enabled and amz -%}
<p class="w-buy">
{%- if amz.bd %}<a class="amz-btn" href="https://www.amazon.co.jp/dp/{{ amz.bd }}?tag={{ tag }}" rel="sponsored noopener" target="_blank">Blu-ray</a>{% endif -%}
{%- if amz.dvd %}<a class="amz-btn" href="https://www.amazon.co.jp/dp/{{ amz.dvd }}?tag={{ tag }}" rel="sponsored noopener" target="_blank">DVD</a>{% endif -%}
{%- if amz.pv %}<a class="amz-btn" href="https://www.amazon.co.jp/dp/{{ amz.pv }}?tag={{ tag }}" rel="sponsored noopener" target="_blank">プライムビデオ</a>{% endif -%}
<span class="pr-label">[PR]</span></p>
{%- endif -%}
{%- if w.sp -%}
<details class="spoiler-box"><summary>⚠ ネタバレあり要約を表示(結末まで書いています)</summary><p>{{ w.sp }}</p></details>
{%- elif w.sp_pending -%}
<p class="sp-pending">⚠ ネタバレあり要約は準備中です(公開から日が浅いため、確認でき次第追加します)</p>
{%- endif -%}
{{ moreLink | safe }}
</div></details>
{%- endif -%}
{%- endmacro -%}
