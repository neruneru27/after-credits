{#- 劇場イベントカード(/live/用)。終了後は「上映終了」表記で過去ログとして残す -#}
{%- for ev in theatricalEvents.events %}
<div class="event-card" id="event-{{ ev.id }}" data-start="{{ ev.start_date }}" data-end="{{ ev.end_date }}">
  <p class="event-card-head"><span class="event-tag">{{ ev.type }}</span><span class="event-status" data-role="status"></span></p>
  <h3>{{ ev.title }}</h3>
  <p class="event-dates">{{ ev.start_date | fmtDate }} 〜 {{ ev.end_date | fmtDate }}</p>
  <p class="event-summary">{{ ev.summary }}</p>
  {%- if ev.versions %}
  <div class="event-versions">
    {%- for v in ev.versions %}
    <div class="event-ver"><b>{{ v.name }}</b><span>{{ v.runtime }}</span><p>{{ v.note }}</p></div>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- if ev.infinity_vision %}
  <details class="event-detail">
    <summary>INFINITY VISIONとは?</summary>
    <p>{{ ev.infinity_vision.what }}</p>
    <ul>{% for c in ev.infinity_vision.criteria %}<li>{{ c }}</li>{% endfor %}</ul>
    {%- if ev.infinity_vision.note %}<p class="term-note">{{ ev.infinity_vision.note }}</p>{% endif %}
  </details>
  {%- endif %}
  {%- if ev.bonus %}<p class="event-bonus">🎁 {{ ev.bonus }}</p>{% endif %}
  {%- if ev.added_footage %}
  {%- set af = ev.added_footage %}
  <div class="added-footage">
    <h4 class="af-head">🎞 追加映像について(ネタバレなし)</h4>
    <p class="af-summary">{{ af.summary }}</p>
    {%- if af.note %}<p class="af-note">{{ af.note }}</p>{% endif %}
    {%- if af.prerequisites and af.prerequisites.length %}
    <p class="af-sub">追加映像の理解に必要な作品</p>
    <ul class="af-pre">
      {%- for pre in af.prerequisites %}
      <li><a href="{{ ('/live/' + pre.work_id + '/') | url }}">{{ pre.work_id | workTitle(mcu.works) }}</a><span>{{ pre.why }}</span></li>
      {%- endfor %}
    </ul>
    {%- endif %}
    {%- if af.key_facts and af.key_facts.length %}
    <details class="spoiler-box af-facts">
      <summary>⚠ 追加映像で判明した事実を表示(ネタバレ)</summary>
      <ul>{% for k in af.key_facts %}<li>{{ k }}</li>{% endfor %}</ul>
    </details>
    {%- endif %}
    {%- if af.scenes and af.scenes.length %}
    <p class="af-sub">各シーンの内容({{ af.scenes.length }}項目・すべてネタバレ)</p>
    <div class="app-list">
      {%- for sc in af.scenes %}
      <div class="app-item">
        <p class="app-head"><span class="credit-pos {{ 'mid' if '本編' in sc.pos else 'post' }}">{{ sc.no }}. {{ sc.pos }}</span></p>
        <details class="spoiler-box"><summary>⚠ シーンの内容を表示(ネタバレ)</summary><p>{{ sc.sp }}</p></details>
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if af.reporter_note %}<p class="af-src"><b>鑑賞記録:</b> {{ af.reporter_note }}</p>{% endif %}
    {%- if af.source_note %}<p class="af-src">{{ af.source_note }}</p>{% endif %}
  </div>
  {%- endif %}
  <p class="event-links">
    <a class="amz-btn" href="{{ ev.official_url }}" target="_blank" rel="noopener">公式サイト(劇場情報)</a>
    {%- if theatricalArticles[ev.id] %}<a class="amz-btn" href="{{ theatricalArticles[ev.id] | url }}">解説記事を読む</a>{% endif %}
    {%- if ev.base_work_id %}<a class="amz-btn" href="{{ ('/live/' + ev.base_work_id + '/') | url }}">作品ページ</a>{% endif %}
  </p>
  <p class="term-note">{{ ev.theater_list_note }}</p>
</div>
{%- endfor %}
